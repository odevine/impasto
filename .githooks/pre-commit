#!/usr/bin/env bash
# Pre-commit checks. Enable with: make hooks  (sets core.hooksPath to .githooks)
# Keeps the commit fast: format, vet, and the plain test suite. The race
# detector and fuzzing run in CI, not on every commit.
set -euo pipefail

staged_go=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -z "$staged_go" ]; then
	exit 0
fi

echo "pre-commit: gofmt"
unformatted=$(gofmt -l $staged_go)
if [ -n "$unformatted" ]; then
	echo "These staged files are not gofmt-clean:"
	echo "$unformatted"
	echo "Fix with: gofmt -w ."
	exit 1
fi

echo "pre-commit: go vet"
go vet ./...

echo "pre-commit: go test"
go test ./...
